# Discord Widget Reloader 環境変数設定ファイル
# このファイルをコピーして .env にリネームし、値を書き換えてください
# cp .env.example .env

# Discord Developer Portal の Application ID (General Information から取得)
DISCORD_APPLICATION_ID=your_application_id

# ウィジェットを表示する自分のDiscordユーザーID
# (開発者モード有効化後、自分のユーザー名を右クリック→「ユーザーIDをコピー」)
DISCORD_USER_ID=your_discord_user_id

# Developer Portal の Bot ページで Reset Token して取得したトークン
DISCORD_BOT_TOKEN=your_bot_token

# 同期間隔（秒）。デフォルト300秒(5分)
SYNC_INTERVAL_SECONDS=300
